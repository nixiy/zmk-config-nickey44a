#include <zephyr/dt-bindings/i2c/i2c.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

#include "nickey44a.dtsi"

/ {
    kscan_noop: kscan_noop {
        compatible = "zmk,kscan-mock";
        events = <>;
        rows = <4>;
        columns = <12>;
    };

    pointing_listener: pointing_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
                           <&zip_xy_scaler 1 4>;
        status = "okay";
    };
};

&default_transform {
    col-offset = <6>;
};

&physical_layout0 {
    kscan = <&kscan_noop>;
};

&kscan0 {
    status = "disabled";

    col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            ;
};

&xiao_i2c {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    pointing_device: pointing_device@57 {
        compatible = "lpps";
        reg = <0x57>;
        irq-gpios = <&gpio0 28 GPIO_PULL_UP>;
        status = "okay";
    };
};
